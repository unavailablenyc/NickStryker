# Booking and services -> a fitting request.
/book-online                           /fitting.html               301
/booking-calendar                      /fitting.html               301
/service-page/belt-bag                 /fitting.html?piece=Belt%20Bag            301
/service-page/strap                    /fitting.html?piece=Strap                 301
/service-page/bespoke-experience       /fitting.html?piece=Bespoke               301
/service-page/*                        /fitting.html               301

# Wix cart, checkout, and the template portfolio are not part of this site.
/cart                                  /fitting.html               301
/checkout                              /fitting.html               301
/thank-you-page                        /fitting.html               301
/portfolio                             /                               301
/portfolio-collections/*               /                               301
/ndnd                                  /                               301
